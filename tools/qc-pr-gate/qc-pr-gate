#!/usr/bin/env bash
# Launcher. Prefers a local .venv (QC-station / box layout); falls back to the
# ambient python3 so CI runners can invoke the gate without building a venv.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"

if [ -n "${QC_PYTHON:-}" ]; then
  PY="$QC_PYTHON"
elif [ -x "$ROOT/.venv/bin/python" ]; then
  PY="$ROOT/.venv/bin/python"
elif PY="$(command -v python3)"; then
  :
elif PY="$(command -v python)"; then
  :
else
  echo "qc-pr-gate: no python interpreter found (set QC_PYTHON)" >&2
  exit 3
fi

exec "$PY" "$ROOT/qc_pr_gate.py" "$@"
